;-------------------------------------------------------------------------
; Tables (BBC only).
;-------------------------------------------------------------------------

; Address of each screen line. MODE 2 layout: +1 per line within a
; character row, +640 per character row.
line_addrs_lo:
                .for line_=0,line_<screen_line_count,line_+=1
                .byte <(screen+(line_>>3)*640+(line_&7))
                .next
line_addrs_hi:
                .for line_=0,line_<screen_line_count,line_+=1
                .byte >(screen+(line_>>3)*640+(line_&7))
                .next

;-------------------------------------------------------------------------

; MODE 2 byte with both pixels in a given logical colour. Left pixel
; is bits 7,5,3,1; right pixel is bits 6,4,2,0.
solid_bytes:
                .for colour_=0,colour_<16,colour_+=1
                .byte ((colour_&8)<<4|(colour_&4)<<3|(colour_&2)<<2|(colour_&1)<<1)*3/2
                .next

;-------------------------------------------------------------------------

; Colour band of each PF row. Kernel line y draws PF row y+10 with
; band unk_FEB5[y]: y 0-21 band 3, 22-37 band 2, 38-45 band 1, 46+
; band 0. Rows 10-0 come after the kernel loop and stay in the band
; of kernel line 1 (band 3).
pf_row_bands:
                .for row_=0,row_<=pf_top_row,row_+=1
                .byte row_<32?3:(row_<48?2:(row_<56?1:0))
                .next

; Colour roles of each band.
band_bg_roles:  .byte role_sky,role_sky,role_sky,role_water
band_fg_roles:  .byte role_tree,role_khaki,role_lily,role_lily

;-------------------------------------------------------------------------

; Game colour variable that drives each dynamic role.
role_sources:
                .byte byte_98           ; role_sky
                .byte byte_98+3         ; role_water
                .byte byte_9C           ; role_tree
                .byte byte_9C+1         ; role_khaki
                .byte byte_9C+2         ; role_lily
                .byte COLUP0            ; role_frog0
                .byte COLUP1            ; role_frog1
                .byte COLUP1            ; role_spare
                .byte tongue_colour     ; role_tongue
                .byte pl_colours        ; role_score0
                .byte pl_colours+1      ; role_score1
                .byte byte_87           ; role_score_bg
                .cerror *-role_sources!=num_dynamic_roles

;-------------------------------------------------------------------------

; Each byte with its bits in reverse order, for reflected sprites.
bit_reverse:
                .for i_=0,i_<256,i_+=1
                .byte (i_&1)<<7|(i_&2)<<5|(i_&4)<<3|(i_&8)<<1|(i_&16)>>1|(i_&32)>>3|(i_&64)>>5|(i_&128)>>7
                .next

;-------------------------------------------------------------------------

; Sprite masks: for each GRP byte, the screen bits to keep in each of
; the 4 byte columns of an 8-pixel sprite at an even X (column j is
; pixels from bits 7-2j and 6-2j). Left pixel is bits 7,5,3,1; right
; is 6,4,2,0.
sprite_pair_mask .function pair_
                .endf pair_==0?$ff:(pair_==1?$aa:(pair_==2?$55:$00))
                .align 256
sprite_masks_0:
                .for i_=0,i_<256,i_+=1
                .byte sprite_pair_mask((i_>>6)&3)
                .next
sprite_masks_1:
                .for i_=0,i_<256,i_+=1
                .byte sprite_pair_mask((i_>>4)&3)
                .next
sprite_masks_2:
                .for i_=0,i_<256,i_+=1
                .byte sprite_pair_mask((i_>>2)&3)
                .next
sprite_masks_3:
                .for i_=0,i_<256,i_+=1
                .byte sprite_pair_mask((i_>>0)&3)
                .next

;-------------------------------------------------------------------------

                .include "tia_to_beeb.s65"
