;-------------------------------------------------------------------------
; Rendering (BBC only).
;
; 160x192 MODE 2 screen. TIA colour clocks map 1:1 to MODE 2 pixels.
; Everything in the background is made of 4-pixel playfield blocks
; (2 screen bytes), 40 to a line.
;
; Colours are by role: each 2600 colour register role gets its own
; logical colour, and update_palette keeps the palette in step with
; the game's colour variables.
;-------------------------------------------------------------------------

screen=$4400
screen_line_count=192
blocks_per_line=40

; Vertical layout, following the 2600 display: the score area (2
; blank lines, 5 digit rows of 3 lines, 4 blank lines), then PF rows
; 84..11 drawn by the kernel loop and rows 10..0 drawn after it, 2
; lines per row. That's 191 lines; the last is blank.
score_digits_line=2
score_digit_row_lines=3
score_area_end_line=score_digits_line+5*score_digit_row_lines
score0_first_block=4            ; PF1, left half
score1_first_block=24           ; PF1, right half
pf_line=21
pf_row_lines=2
pf_top_row=84
border_line=pf_line+(pf_top_row+1)*pf_row_lines
                .cerror border_line!=screen_line_count-1

; Logical colour for each role.
role_sky=0                      ; byte_98 (bands 0-2 BG)
role_water=1                    ; byte_9B (band 3 BG)
role_tree=2                     ; byte_9C (band 0 PF)
role_khaki=3                    ; byte_9D (band 1 PF)
role_lily=4                     ; byte_9E (bands 2-3 PF)
role_frog0=5                    ; COLUP0
role_frog1=6                    ; COLUP1 (and flies)
role_sky2=7                     ; second colours of the dithered roles
role_tongue=8                   ; tongue_colour
role_score0=9                   ; pl_colours
role_score1=10                  ; pl_colours+1
role_water2=11
num_dynamic_roles=11            ; (role_sky2 is updated with role_sky)
role_border=12                  ; always black
role_tree2=13
role_khaki2=14
role_lily2=15
num_roles=16

; The background roles are dithered: a checkerboard of the role's own
; logical colour and its second one (role_seconds), each set from
; tia_to_beeb_pairs. The score area uses the sky's (byte_87, its
; background, is always the sky colour once the BG/PF swap is undone;
; see update_palette).

;-------------------------------------------------------------------------
; Initialise the palette: the fixed roles get set once, and the
; dynamic ones are marked as needing setting.
;-------------------------------------------------------------------------

init_palette:.block
                ldx #num_dynamic_roles-1
                lda #1          ; never a game colour
-
                sta role_colours,x
                dex
                bpl -

                ldx #role_border
                lda #0
                jmp set_role_colour
                .endblock

;-------------------------------------------------------------------------
; Bring the palette up to date with the game's colour variables.
;-------------------------------------------------------------------------

update_palette:.block
                ; When the 2600 code inverts the playfield
                ; (pf_eor_value=$ff), it swaps the BG and PF colours
                ; too, so the picture looks the same. The BBC picture
                ; isn't inverted, so read the colours swapped back.
                ldy #0
                lda pf_eor_value
                beq +
                ldy #num_dynamic_roles
+
                sty palette_sources_offset

                ldx #num_dynamic_roles-1
-
                txa
                clc
                adc palette_sources_offset
                tay
                lda role_sources,y
                tay
                lda $0000,y
                ldy role_pair_seconds,x
                cpy #skip_role
                beq next
                cmp role_colours,x
                beq next
                sta role_colours,x
                cpy #solid_role
                beq solid
                sty pair_second
                jsr set_role_pair
                jmp next
solid:
                jsr set_role_colour
next:
                dex
                bpl -
                rts
                .endblock

; For each dynamic role: its second colour if dithered, solid_role if
; not, skip_role for role_sky2 (set along with role_sky).
solid_role=$ff
skip_role=$fe
role_pair_seconds:
                .byte role_sky2,role_water2,role_tree2,role_khaki2,role_lily2
                .byte solid_role,solid_role,skip_role
                .byte solid_role,solid_role,solid_role
                .cerror *-role_pair_seconds!=num_dynamic_roles

; Second logical colour for each logical colour (itself if solid).
role_seconds:
                .byte role_sky2,role_water2,role_tree2,role_khaki2,role_lily2
                .byte role_frog0,role_frog1,role_sky2,role_tongue,role_score0
                .byte role_score1,role_water2,role_border,role_tree2,role_khaki2
                .byte role_lily2

;-------------------------------------------------------------------------
; Set a dithered role's two colours.
;
; Entry: X = role; pair_second = its second logical colour; A = TIA
;        colour
; Exit: X preserved
;-------------------------------------------------------------------------

set_role_pair:.block
                lsr a
                tay
                lda tia_to_beeb_pairs,y
                pha
                lsr a
                lsr a
                lsr a
                lsr a
                jsr set_logical_colour
                pla
                and #$0f
                stx pair_primary
                ldx pair_second
                jsr set_logical_colour
                ldx pair_primary
                rts
                .endblock

;-------------------------------------------------------------------------
; Set the colour of a role.
;
; Writes the video ULA palette directly: VDU 19 through the OS took up
; to ~3ms for a frame's colour changes, eating into the time to render.
; In MODE 2 each logical colour is one write, (logical<<4)|(physical
; EOR 7). The OS's copy of the palette isn't updated, but nothing uses
; it, and with no flashing colours the OS doesn't rewrite the palette.
;
; Entry: X = role (logical colour); A = TIA colour
; Exit: X preserved
;-------------------------------------------------------------------------

set_role_colour:.block
                lsr a
                tay
                lda tia_to_beeb,y
                .endblock

; Entry: X = logical colour, A = physical colour. Exit: X preserved.
set_logical_colour:.block
                eor #7
                sta palette_temp
                txa
                asl a
                asl a
                asl a
                asl a
                ora palette_temp
                sta video_ula_palette
                rts
                .endblock

;-------------------------------------------------------------------------
; Draw the whole background: score area (blank), playfield, border.
;-------------------------------------------------------------------------

draw_background:.block
                ; Score area, blank (sky). (draw_scores only draws the
                ; blocks the digits are in.)
                lda #0
                sta line
-
                jsr set_line_parity
                lda #role_sky
                jsr fill_blocks
                lda line
                jsr draw_line
                inc line
                lda line
                cmp #pf_line
                bne -

                ; Playfield.
                lda #pf_top_row
                sta row
-
                ldx row
                jsr set_line_parity
                jsr build_pf_blocks
                lda line
                jsr draw_line
                inc line
                ldx row         ; (build_pf_blocks doesn't preserve X)
                jsr set_line_parity
                jsr build_pf_blocks
                lda line
                jsr draw_line
                inc line
                dec row
                bpl -

                ; Border.
                jsr set_line_parity
                lda #role_border
                jsr fill_blocks
                lda #border_line
                jmp draw_line
                .endblock

; pattern_parity = line&1. Preserves X.
set_line_parity:.block
                lda line
                and #1
                sta pattern_parity
                rts
                .endblock

;-------------------------------------------------------------------------
; Screen byte for a role on this line: the checkerboard of its two
; colours (both the same if it's solid).
;
; Entry: A = role; pattern_parity = line&1
; Exit: A = byte; X preserved
;-------------------------------------------------------------------------

get_pattern_byte:.block
                tay
                lda role_seconds,y
                sta pattern_second
                lda pattern_parity
                bne odd
                ; Even line: own colour left, second right.
                lda solid_bytes,y
                and #%10101010
                sta pattern_temp
                ldy pattern_second
                lda solid_bytes,y
                and #%01010101
                ora pattern_temp
                rts
odd:
                ; Odd line: second colour left, own right.
                lda solid_bytes,y
                and #%01010101
                sta pattern_temp
                ldy pattern_second
                lda solid_bytes,y
                and #%10101010
                ora pattern_temp
                rts
                .endblock

;-------------------------------------------------------------------------
; Draw the scores, from pl_scores.
;
; Entry: A = which: bit 0 = player 0, bit 1 = player 1
;
; As on the 2600, they're PF1 data: player 0's in PF1 on the left half
; of the screen, player 1's in PF1 on the right half (not reflected).
;-------------------------------------------------------------------------

draw_scores:.block
                sta scores_to_draw
                lda pl_scores+0
                sta drawn_scores+0
                lda pl_scores+1
                sta drawn_scores+1

                ; Find each digit's data, as an offset from
                ; left_digits_pf_data, same as prepare_display: left
                ; digits at 5*digit, right digits at 50+5*digit.
                ldx #1
-
                txa
                asl a
                tay             ; Y=2*player index
                lda pl_scores,x
                lsr a
                lsr a
                lsr a
                lsr a
                sta digit_offsets+0,y
                asl a
                asl a
                adc digit_offsets+0,y
                sta digit_offsets+0,y
                lda pl_scores,x
                and #$0f
                sta digit_offsets+1,y
                asl a
                asl a
                adc digit_offsets+1,y
                adc #50
                sta digit_offsets+1,y
                dex
                bpl -

                ; Digit data is stored bottom row first.
                lda #4
                sta row
                lda #score_digits_line
                sta line
digit_rows_loop:
                lda #score_digit_row_lines
                sta digit_line_count
line_loop:
                ; Background: the sky's pattern for this line.
                jsr set_line_parity
                lda #role_sky
                jsr get_pattern_byte
                sta bg_byte

                ; Player 0.
                lda scores_to_draw
                lsr a
                bcc +
                ldx #role_score0
                lda #0
                jsr build_digit_blocks
                lda #score0_first_block
                jsr draw_digit_line
+
                ; Player 1.
                lda scores_to_draw
                and #2
                beq +
                ldx #role_score1
                lda #2
                jsr build_digit_blocks
                lda #score1_first_block
                jsr draw_digit_line
+
                inc line
                dec digit_line_count
                bne line_loop

                dec row
                bpl digit_rows_loop
                rts

; Draw this line of a player's digits.
; Entry: A = first block (score0_first_block or score1_first_block)
draw_digit_line:
                sta draw_first_block
                clc
                adc #8
                sta draw_end_block
                lda line
                jmp draw_line_part

; Entry: X = colour role; A = 2*player index
build_digit_blocks:
                tay
                lda solid_bytes,x
                sta fg_byte
                lda digit_offsets+0,y
                clc
                adc row
                tax
                lda left_digits_pf_data,x
                pha
                lda digit_offsets+1,y
                clc
                adc row
                tax
                pla
                eor left_digits_pf_data,x
                sta pf_bits
                ; PF1 is blocks 4-11 on the left, 24-31 on the right.
                lda #score0_first_block
                cpy #0
                beq +
                lda #score1_first_block
+
                tay
                ldx #8
-
                asl pf_bits
                jsr put_block
                dex
                bne -
                rts
                .endblock

;-------------------------------------------------------------------------
; Fill blocks with a role's pattern.
;
; Entry: A = role; pattern_parity set
;-------------------------------------------------------------------------

fill_blocks:.block
                jsr get_pattern_byte
                sta bg_byte
                .endblock
fill_blocks_with_bg_byte:.block
                ldx #blocks_per_line-1
-
                sta blocks,x
                dex
                bpl -
                rts
                .endblock

;-------------------------------------------------------------------------
; Build blocks for a playfield row.
;
; The playfield is reflected: PF0 bits 4-7, PF1 bits 7-0, PF2 bits 0-7
; from left to right, then the same again mirrored.
;
; Entry: X = PF row (0-84)
;-------------------------------------------------------------------------

build_pf_blocks:.block
                lda pf_row_bands,x
                sta pf_bits     ; (temp)
                tay
                lda band_fg_roles,y
                jsr get_pattern_byte
                sta fg_byte
                ldy pf_bits
                lda band_bg_roles,y
                jsr get_pattern_byte
                sta bg_byte

                ldy #0

                lda pf0_data,x
                lsr a
                lsr a
                lsr a
                lsr a
                sta pf_bits
                jsr put_pf_bits_lsb_first_4

                lda pf1_data,x
                sta pf_bits
                txa
                pha
                ldx #8
-
                asl pf_bits
                jsr put_block
                dex
                bne -
                pla
                tax

                lda pf2_data,x
                sta pf_bits
                jsr put_pf_bits_lsb_first_4
                jsr put_pf_bits_lsb_first_4

                ; Mirror into the right half.
                ldx #blocks_per_line/2-1
-
                lda blocks,x
                sta blocks,y
                iny
                dex
                bpl -
                rts

put_pf_bits_lsb_first_4:
                jsr put_pf_bits_lsb_first_2
put_pf_bits_lsb_first_2:
                lsr pf_bits
                jsr put_block
                lsr pf_bits
                jmp put_block
                .endblock

;-------------------------------------------------------------------------
; Store fg_byte (C=1) or bg_byte (C=0) to the next block.
;
; Entry: Y = block index
; Exit: Y incremented; X, C preserved
;-------------------------------------------------------------------------

put_block:.block
                lda bg_byte
                bcc +
                lda fg_byte
+
                sta blocks,y
                iny
                rts
                .endblock

;-------------------------------------------------------------------------
; Draw the blocks onto a screen line.
;
; Entry: A = screen line
; Exit: X preserved
;-------------------------------------------------------------------------

draw_line:.block
                ldy #0
                sty draw_first_block
                ldy #blocks_per_line
                sty draw_end_block
                .endblock

;-------------------------------------------------------------------------
; Draw some of the blocks onto a screen line.
;
; Entry: A = screen line; draw_first_block, draw_end_block = blocks
;        to draw (first, last+1)
; Exit: X preserved
;-------------------------------------------------------------------------

draw_line_part:.block
                stx draw_line_x
                tax

                ; ptr = line address + first block*16 (2 bytes, 8 apart)
                lda draw_first_block
                sta ptr+1
                lda #0
                lsr ptr+1
                ror a
                lsr ptr+1
                ror a
                lsr ptr+1
                ror a
                lsr ptr+1
                ror a           ; A:ptr+1 = first*16 (as hi:lo shifted)
                clc
                adc line_addrs_lo,x
                sta ptr+0
                lda ptr+1
                adc line_addrs_hi,x
                sta ptr+1
                lda ptr+0
                clc
                adc #8
                sta ptr2+0
                lda ptr+1
                adc #0
                sta ptr2+1

                ldx draw_first_block
                ldy #0
-
                lda blocks,x
                sta (ptr),y
                sta (ptr2),y
                tya
                clc
                adc #16
                tay
                bcc +
                inc ptr+1
                inc ptr2+1
+
                inx
                cpx draw_end_block
                bne -

                ldx draw_line_x
                rts
                .endblock
