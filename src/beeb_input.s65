;-------------------------------------------------------------------------
; Keyboard input (BBC only).
;
; Builds the 2600 input register images directly, so the shared code
; reads them unchanged:
;
;   SWCHA  bits 7-4 = P0 ~R ~L ~D ~U, bits 3-0 = P1 ~R ~L ~D ~U
;   INPT4  bit 7 = ~P0 fire;  INPT5 bit 7 = ~P1 fire
;   SWCHB  bit 0 = ~reset, bit 6 = P0 pro, bit 7 = P1 pro
;
; (0 = pressed throughout, as on the 2600.)
;-------------------------------------------------------------------------

; Negative INKEY codes, as bytes.
inkey_a=$100-66
inkey_d=$100-51
inkey_s=$100-82
inkey_w=$100-34
inkey_tab=$100-97
inkey_right=$100-122
inkey_left=$100-26
inkey_down=$100-42
inkey_up=$100-58
inkey_return=$100-74
inkey_f0=$100-33
inkey_f1=$100-114
inkey_f2=$100-115
inkey_f3=$100-116

inkey_escape=$100-113

; Default player keys (copied to player_keys, which the title screen
; can redefine): SWCHA bits 7 down to 0 (P0 R L D U, P1 R L D U), then
; P0 fire, P1 fire.
default_player_keys:
                .byte inkey_d,inkey_a,inkey_s,inkey_w
                .byte inkey_right,inkey_left,inkey_down,inkey_up
                .byte inkey_tab,inkey_return
num_player_keys=*-default_player_keys

;-------------------------------------------------------------------------

init_input:.block
                ; Console switches: not reset, not select, colour,
                ; both players amateur.
                lda #%00001011
                sta SWCHB
                lda #0
                sta toggle_keys
                sta player_is_cpu+0
                sta player_is_cpu+1
                sta attract_mode
                sta test_key
                ldx #num_player_keys-1
-
                lda default_player_keys,x
                sta player_keys,x
                dex
                bpl -
                rts
                .endblock

;-------------------------------------------------------------------------

scan_keyboard:.block
                ; Read the keyboard matrix directly (much quicker than
                ; OSBYTE &81): interrupts off, OS scanning paused.
                php
                sei
                lda #$7f        ; port A bit 7 (key pressed) is input
                sta system_via.ddra
                lda #3          ; latch bit 3 (keyboard enable) low:
                sta system_via.orb ; OS auto scan off

                ; Joysticks.
                ldy #0
-
                lda player_keys,y
                jsr read_key
                rol SWCHA       ; C=0 if pressed
                iny
                cpy #8
                bne -

                ; Fire buttons.
                lda player_keys+8
                jsr read_key
                ror INPT4
                lda player_keys+9
                jsr read_key
                ror INPT5

                ; Escape (back to the title screen).
                lda #inkey_escape
                jsr read_key
                lda #0
                rol a
                eor #1
                sta escape_pressed ; 1 if pressed

                ; A CPU player's keys do nothing, so they can't take
                ; the frog back. (In attract mode, both.)
                lda player_is_cpu+0
                ora attract_mode
                beq +
                lda SWCHA
                ora #$f0
                sta SWCHA
                lda INPT4
                ora #$80
                sta INPT4
+
                lda player_is_cpu+1
                ora attract_mode
                beq +
                lda SWCHA
                ora #$0f
                sta SWCHA
                lda INPT5
                ora #$80
                sta INPT5
+

                ; Reset.
                lda #inkey_f0
                jsr read_key
                lda SWCHB
                and #$fe
                adc #0          ; bit 0 = C = ~reset
                sta SWCHB

                ; Toggle keys, acting on each press: f1/f2 the
                ; difficulty switches, f3 the video mode (50/60Hz).
                lda #inkey_f3
                jsr read_key
                rol keys_temp
                lda #inkey_f2
                jsr read_key
                rol keys_temp
                lda #inkey_f1
                jsr read_key
                lda keys_temp
                rol a           ; bit 2 = ~f3, bit 1 = ~f2, bit 0 = ~f1
                eor #7          ; bit 2 = f3, bit 1 = f2, bit 0 = f1
                and #7
                sta keys_temp
                eor toggle_keys ; bits set if changed...
                and keys_temp   ; ...and now pressed
                ldx keys_temp
                stx toggle_keys
                sta keys_temp   ; newly pressed
                lsr a           ; C=f1 newly pressed
                bcc +
                pha
                lda SWCHB
                eor #$40        ; P0 difficulty
                sta SWCHB
                pla
+
                lsr a           ; C=f2 newly pressed
                bcc +
                lda SWCHB
                eor #$80        ; P1 difficulty
                sta SWCHB
+

                lda #$0b        ; OS auto scan on again
                sta system_via.orb
                plp

                lda keys_temp
                and #4          ; f3 newly pressed?
                beq +
                lda requested_video_mode
                eor #1
                sta requested_video_mode
+

                ; Stop the keyboard buffer filling up.
                lda #21
                ldx #0
                jmp osbyte
                .endblock

;-------------------------------------------------------------------------
; Read a key, from the keyboard matrix. scan_keyboard sets the System
; VIA up for this.
;
; Entry: A = negative INKEY code, as a byte (the internal key number,
;        row in bits 4-6 and column in bits 0-3, is that EOR $ff)
; Exit: C=0 if pressed, C=1 if not; X, Y preserved
;-------------------------------------------------------------------------

read_key:.block
                eor #$ff
                sta system_via.ora_no_handshake
                lda system_via.ora_no_handshake ; bit 7 set if pressed
                eor #$80
                asl a           ; C=0 if pressed
                rts
                .endblock
