;-------------------------------------------------------------------------
; BBC workspace (outside zero page).
;-------------------------------------------------------------------------

; Last TIA colour applied to each dynamic role.
role_colours:   .fill num_dynamic_roles

; Screen bytes for the line being drawn, one per 4-pixel block.
blocks:         .fill blocks_per_line

; Renderer temps.
row:            .fill 1
line:           .fill 1
fg_byte:        .fill 1
bg_byte:        .fill 1
pf_bits:        .fill 1
draw_line_x:    .fill 1
digit_offsets:  .fill 4         ; p0 left, p0 right, p1 left, p1 right

; Input.
difficulty_keys:.fill 1         ; bit 0 = f1 down, bit 1 = f2 down
keys_temp:      .fill 1
inkey_y:        .fill 1

; Scores currently on screen.
drawn_scores:   .fill 2

; Sprite save-under: what each sprite saved, and where from.
saved_rows:     .fill num_sprites   ; 0 = nothing saved
saved_lines:    .fill num_sprites
saved_cols:     .fill num_sprites
saved_col_offsets_lo:.fill num_sprites
saved_col_offsets_hi:.fill num_sprites
save_buffers:   .fill save_buffers_size

; Sprite drawing temps.
sprite_index:   .fill 1
sprite_line:    .fill 1
sprite_rows:    .fill 1
sprite_data_offset:.fill 1
sprite_x:       .fill 1
sprite_reflect: .fill 1
sprite_col:     .fill 1
sprite_cols:    .fill 1
sprite_width_cols:.fill 1
sprite_col_offset:.fill 2
sprite_entry:   .fill 2
fly_write_x:    .fill 1
clip_skip:      .fill 1

; Time taken by the last update_palette+render_frame, in us.
render_time:    .fill 2

; Tongue to draw, recorded by prepare_display.
tongue_pl_y:    .fill 1         ; pl_y of its frog, or 0 if none
tongue_x:       .fill 1

palette_sources_offset:.fill 1

; Where the flies and tongue were drawn this frame (index: sprite slot
; minus sprite_fly0), for check_collisions. drawn_rows=0 if not drawn.
drawn_lines:    .fill 3
drawn_rows:     .fill 3
drawn_xs:       .fill 3
drawn_widths:   .fill 3
fly_is_m0:      .fill 2         ; 1 if drawn by M0 this frame, 0 if M1

; Sound: SN76489 settings wanted this frame, and as last written.
sn_periods_lo:  .fill 3         ; tone channels 0-2
sn_periods_hi:  .fill 3
sn_attens:      .fill 4         ; tone channels 0-2, noise
sn_written_periods_lo:.fill 3
sn_written_periods_hi:.fill 3
sn_written_attens:.fill 4
channel_atten:  .fill 1
channel_kind:   .fill 1
channel_index:  .fill 1
