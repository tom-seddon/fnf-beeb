;-------------------------------------------------------------------------
; Frogs and Flies - Atari 2600 build
;
; Reassembles byte-for-byte to the original NTSC (PAL=false) or PAL
; (PAL=true) ROM.
;
; Platform-independent code lives in src/logic.s65 and src/sound.s65.
; Between them they refer to the following 2600 hardware registers,
; which another platform must provide (e.g. as RAM shadow variables
; that its own code reads or writes):
;
;   read:        SWCHA SWCHB INPT4 (,x - so INPT5 too) COLUP0 CXM0FB CXM1FB
;   written:     COLUP0 COLUP1 VDELP1 AUDC0 AUDF0 AUDV0 (,x)
;
; COLUP0/COLUP1/VDELP1 are targets of initialise_memory's zp,x
; stores, so they must be in zero page.
;-------------------------------------------------------------------------

TARGET_2600=1
TARGET_BEEB=2
TARGET=TARGET_2600

                .include "src/constants.s65"

;-------------------------------------------------------------------------

* = $00
                .include "src/tia.s65"
                .cerror *!=$80,"TIA registers must end at $80"
                .include "src/ram.s65"

;-------------------------------------------------------------------------

                .include "src/riot.s65"

;-------------------------------------------------------------------------

* = $F000
                .include "src/tia_kernel.s65"

;-------------------------------------------------------------------------

main:
                sei
                cld

debounce_reset:
                lda SWCHB       ; Console switches
                                ; +---+---+---+---+---+---+---+---+
                                ; |Di1|Di0|   |   |Col|   |~GS|~GR|
                                ; +-+-+-+-+---+---+-+-+---+-+-+-+-+
                                ;   |   |           |       |   |
                                ;   |   |           |       |   +--- 0 = game reset
                                ;   |   |           |       +------- 0 = game select
                                ;   |   |           +--------------- 0 = B&W, 1 = colour
                                ;   |   +--------------------------- 0 = P0 amateur, 1 = P0 pro
                                ;   +------------------------------- 0 = P1 amateur, 1 = P1 pro
                lsr a           ; C=0 if game reset
                bcc debounce_reset
                ldy Intim
                lda #0
                tax

clear_memory:
                sta 0,x
                txs
                inx
                bne clear_memory
                sty random_seed ; random_seed???
                jsr handle_players_inputs
                jsr initialise_memory

main_loop:
                .if PAL
                ; 59*64 = 3776 clocks
                lda #59         ; 3162.4 us; 49.4125 scanlines
                .else
                ; 30*64 = 1920 clocks
                lda #30         ; 1608 us; 25.125 scanlines
                .endif
                sta Tim64t      ; set 64 clock interval
                lda SWCHB       ; Console switches
                lsr a           ; extract reset button state
                bcc main        ; taken if reset button pressed

                jsr sub_F6BE
                jsr prepare_display
                inc byte_B3

loc_F1A7:
                lda Intim
                bne loc_F1A7
                ldx #3
                sta WSYNC       ; wait for leading edge of horizontal blank
                stx VSYNC       ; start vertical sync
; do 4 lines of vertical sync

do_vertical_sync:
                sta WSYNC       ; wait for leading edge of horizontal blank
                dex
                bne do_vertical_sync
                stx VSYNC       ; clear vertical sync
                .if PAL
                lda #78         ; vblank time = 4180.8 us; 64.325 scanlines
                .else
                lda #48
                .endif
                sta Tim64t      ; vblank time = 2527.8 us; 39.5 scanlines
                jsr handle_players_inputs
                jsr update_player_physics
                jsr update_player_logic
                jsr update_tongues
                jsr sub_F5FD
                jsr sub_F8F0
                jsr sub_FA7E
                jsr update_sounds
                sta CXCLR       ; clear collision latches

wait_for_end_of_vblank:
                lda Intim
                bne wait_for_end_of_vblank
                jsr do_display
                jmp main_loop

;-------------------------------------------------------------------------

                .include "src/logic.s65"
                .include "src/sound.s65"
                .include "src/data_digits.s65"
                .include "src/data_grp.s65"
                .include "src/data_pf.s65"
                .include "src/tia_data.s65"

;-------------------------------------------------------------------------

                .if PAL
                .fill $fffa-*,$00
                .else
                .fill $fffa-*,$ff
                .endif
                .word main
                .word main
                .word main

                .end
